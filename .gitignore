/AppDir/
/squashfs-root/
/fcitx5-wetype/build/
/fcitx5-wetype/build-*/
/WeTypeIME-*.AppImage
/core
/core.*
**/__pycache__/
*.py[cod]

# Local logs and test output.
*.log
*.csv

